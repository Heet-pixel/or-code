PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smart-qr-billing
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Timezone used for "today" / daily revenue on the dashboard
TZ=Asia/Kolkata
# Optional: only needed if you serve the client from a different origin.
# Leave blank to allow all origins (auth is via Bearer token, not cookies).
CLIENT_ORIGIN=
