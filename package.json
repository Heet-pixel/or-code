{
  "name": "smart-qr-billing",
  "version": "1.0.0",
  "private": true,
  "description": "Smart QR Billing & Inventory System (server + client)",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "smoke": "npm --prefix server run smoke",
    "setup": "npm run install:all && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4"
  }
}
